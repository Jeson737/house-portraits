---
import { Tabs, TabsList, TabsTab, TabsPanel } from 'accessible-astro-components';
import Image from '~/components/common/Image.astro'; // Koristimo Astrowind komponentu za optimizaciju slika

// 1. Definišemo strukturu podataka koje widget prima
interface TabItem {
  tabName: string;
  title: string;
  price: string;
  description: string;
  image: string | any;
  imageAlt?: string;
}

interface Props {
  title?: string;
  items: TabItem[]; // Niz tabova koji šaljemo iz index.astro
}

const { title, items = [] } = Astro.props;
---

<section class="relative max-w-5xl mx-auto px-4 py-12 md:py-16">
  {title && (
    <h2 class="text-3xl font-bold tracking-tight text-center sm:text-4xl mb-8 dark:text-white">
      {title}
    </h2>
  )}

  <div class="bg-white dark:bg-slate-900 p-6 rounded-xl shadow-md border border-slate-200 dark:border-slate-800">
    <Tabs>
      
      <!-- DINAMIČKA LISTA TABOVA -->
      <TabsList class="flex border-b border-slate-200 dark:border-slate-700 gap-2 mb-6 overflow-x-auto">
        {items.map((item, index) => (
          <TabsTab 
            id={`tab-${index}`} 
            controls={`panel-${index}`} 
            selected={index === 0}
            class="px-4 py-2 font-medium text-slate-600 dark:text-slate-400 border-b-2 border-transparent aria-selected:border-blue-600 aria-selected:text-blue-600 dark:aria-selected:text-blue-400 focus:outline-none whitespace-nowrap"
          >
            {item.tabName}
          </TabsTab>
        ))}
      </TabsList>

      <!-- DINAMIČKI PANELI SA TEKSTOM, CENOM I SLIKOM -->
      {items.map((item, index) => (
        <TabsPanel 
          id={`panel-${index}`} 
          labelledby={`tab-${index}`} 
          selected={index === 0}
          class="focus:outline-none py-2 text-slate-700 dark:text-slate-300"
        >
          <!-- Dvokolumni raspored: tekst levo, slika desno (na mobilnom ide jedno ispod drugog) -->
          <div class="grid md:grid-cols-2 gap-8 items-center">
            
            <!-- Leva strana: Tekst i Cena -->
            <div class="order-2 md:order-1">
              <h3 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white">{item.title}</h3>
              
              <!-- Istaknuta cena -->
              <div class="text-3xl font-extrabold text-blue-600 dark:text-blue-400 my-4">
                {item.price}
              </div>
              
              <p class="text-lg leading-relaxed text-slate-600 dark:text-slate-400">
                {item.description}
              </p>
            </div>

            <!-- Desna strana: Optimizovana Astrowind slika -->
            <div class="order-1 md:order-2 w-full h-64 md:h-80 relative rounded-lg overflow-hidden shadow-lg border border-slate-100 dark:border-slate-800">
              <Image
                src={item.image}
                class="w-full h-full object-cover"
                widths={[400, 768]}
                layout="fill"
                loading={index === 0 ? "eager" : "lazy"}
                alt={item.imageAlt || item.title}
              />
            </div>

          </div>
        </TabsPanel>
      ))}

    </Tabs>
  </div>
</section>
