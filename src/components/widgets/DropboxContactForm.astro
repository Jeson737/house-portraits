---
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const {
  title = 'Get Your Free Sample Portrait',
  subtitle = "Upload a photo of your client's new home and leave your details. We will create a digital watercolor sample completely free of charge!",
  tagline = 'Free Sample',
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-3xl mx-auto ${classes?.container ?? ''}`}
  bg={bg}
>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div class="flex flex-col p-6 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow relative">

    <form
      id="dropbox-upload-form"
      action="https://watercolor-backend.onrender.com/prijavi-probu"
      method="POST"
      enctype="multipart/form-data"
      class="space-y-6 block"
    >
      <!-- Full Name Field -->
      <div>
        <label
          for="name"
          class="block text-sm font-medium text-gray-750 dark:text-slate-350 mb-2"
        >
          Full Name
        </label>

        <input
          type="text"
          name="name"
          id="name"
          required
          autocomplete="name"
          placeholder="John Doe"
          class="py-3 px-4 block w-full rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 text-sm focus:border-primary focus:ring-primary focus:outline-none"
        />
      </div>

      <!-- Email Address Field -->
      <div>
        <label
          for="email"
          class="block text-sm font-medium text-gray-750 dark:text-slate-350 mb-2"
        >
          Email Address
        </label>

        <input
          type="email"
          name="email"
          id="email"
          required
          autocomplete="email"
          placeholder="john@example.com"
          class="py-3 px-4 block w-full rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 text-sm focus:border-primary focus:ring-primary focus:outline-none"
        />
      </div>

      <!-- Image Upload -->
      <div>
        <label
          for="photo"
          class="block text-sm font-medium text-gray-750 dark:text-slate-350 mb-2"
        >
          Upload Home Photo
        </label>

        <div class="flex items-center justify-center w-full">
          <label
            for="photo"
            class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:bg-slate-900 hover:bg-gray-100 dark:border-gray-700 dark:hover:border-gray-600 dark:hover:bg-slate-800 transition-colors"
          >
            <div class="flex flex-col items-center justify-center pt-5 pb-6 px-4 text-center">
              <svg
                class="w-8 h-8 mb-3 text-gray-400 dark:text-gray-500"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 20 16"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a3 3 0 0 0 0 6h2.167M10 15V6m0 0L8 8m2-2 2 2"
                />
              </svg>

              <p class="mb-1 text-sm text-gray-550 dark:text-slate-400 font-semibold">
                Click to upload photo
              </p>

              <p class="text-xs text-gray-400 dark:text-gray-500">
                or drag and drop here (PNG, JPG)
              </p>
            </div>

            <input
              type="file"
              name="photo"
              id="photo"
              accept="image/png,image/jpeg,image/webp"
              required
              class="hidden"
            />
          </label>
        </div>

        <p id="selected-file" class="mt-2 text-sm text-gray-500 dark:text-slate-400"></p>
      </div>

      <!-- Submit Button -->
      <div class="flex justify-center">
        <button
          type="submit"
          id="submit-btn"
          class="w-full sm:w-auto py-3 px-6 inline-flex justify-center items-center gap-x-2 text-sm font-semibold border border-transparent bg-primary text-white hover:bg-primary-dark focus:outline-none transition-colors !rounded-full disabled:opacity-50"
        >
          Submit Free Request
        </button>
      </div>

      <p
        id="error-message"
        class="hidden text-sm text-red-600 dark:text-red-400 text-center"
        role="alert"
        aria-live="polite"
      ></p>
    </form>

    <!-- Success Message -->
    <div
      id="success-message"
      class="hidden flex-col items-center justify-center text-center p-8 bg-green-50 dark:bg-green-950/20 border border-green-200 dark:border-green-800 rounded-lg"
      role="status"
      aria-live="polite"
    >
      <svg
        class="w-16 h-16 text-green-500 mb-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
        />
      </svg>

      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
        Thank You!
      </h3>

      <p class="text-gray-600 dark:text-slate-400 max-w-md">
        Your photo has been successfully received. We will get to work on your
        sample watercolor portrait right away and send it to your email shortly!
      </p>
    </div>
  </div>
</WidgetWrapper>

<script is:inline>
  (() => {
    const initForm = () => {
      const form = document.querySelector('#dropbox-upload-form');
      const successMessage = document.querySelector('#success-message');
      const submitBtn = document.querySelector('#submit-btn');
      const errorMessage = document.querySelector('#error-message');
      const photoInput = document.querySelector('#photo');
      const selectedFile = document.querySelector('#selected-file');

      if (
        !form ||
        form.dataset.initialized === 'true' ||
        !submitBtn ||
        !successMessage ||
        !errorMessage
      ) {
        return;
      }

      form.dataset.initialized = 'true';

      const uploadUrl =
        'https://watercolor-backend.onrender.com/prijavi-probu';

      const originalButtonText = 'Submit Free Request';

      if (photoInput && selectedFile) {
        photoInput.addEventListener('change', () => {
          const file = photoInput.files?.[0];

          selectedFile.textContent = file
            ? `Selected: ${file.name}`
            : '';
        });
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        errorMessage.textContent = '';
        errorMessage.classList.add('hidden');

        if (!form.reportValidity()) {
          return;
        }

        const file = photoInput?.files?.[0];

        if (!file) {
          errorMessage.textContent = 'Please select a photo to upload.';
          errorMessage.classList.remove('hidden');
          return;
        }

        const allowedTypes = [
          'image/jpeg',
          'image/png',
          'image/webp',
        ];

        if (!allowedTypes.includes(file.type)) {
          errorMessage.textContent =
            'Please upload a JPG, PNG, or WebP image.';
          errorMessage.classList.remove('hidden');
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Connecting to upload server...';

        let timeoutId;

        try {
          // Wake up the Render service if necessary.
          // The upload endpoint itself is used for the actual submission.
          submitBtn.textContent = 'Uploading your home photo...';

          const formData = new FormData(form);

          const controller = new AbortController();

          timeoutId = window.setTimeout(() => {
            controller.abort();
          }, 120000);

          const response = await fetch(uploadUrl, {
            method: 'POST',
            body: formData,
            signal: controller.signal,
          });

          const responseText = await response.text();

          let result = {};

          try {
            result = responseText ? JSON.parse(responseText) : {};
          } catch {
            result = { detail: responseText };
          }

          if (!response.ok) {
            throw new Error(
              result.detail ||
                result.message ||
                `Upload failed (HTTP ${response.status}).`
            );
          }

          if (result.status !== 'success') {
            throw new Error(
              result.message || 'The server did not confirm the upload.'
            );
          }

          form.classList.add('hidden');
          successMessage.classList.remove('hidden');
          successMessage.classList.add('flex');
        } catch (error) {
          console.error('Photo upload error:', error);

          if (error.name === 'AbortError') {
            errorMessage.textContent =
              'The upload timed out. Please try again.';
          } else if (error instanceof TypeError) {
            errorMessage.textContent =
              'Could not connect to the upload server. Please check your connection and try again.';
          } else {
            errorMessage.textContent =
              error.message ||
              'Upload failed. Please try again later.';
          }

          errorMessage.classList.remove('hidden');

          submitBtn.disabled = false;
          submitBtn.textContent = originalButtonText;
        } finally {
          if (timeoutId) {
            window.clearTimeout(timeoutId);
          }
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initForm, { once: true });
    } else {
      initForm();
    }
  })();
</script>
